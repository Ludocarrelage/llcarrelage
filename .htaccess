RewriteEngine On

# Retirer index.html uniquement sur les 8 pages publiques.
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html[?\s]
RewriteRule ^((?:carrelage-sol-mur|carrelage-terrasse|carrelage-salle-de-bain|douche-italienne|faience|depose-carrelage|ragreage-sol)/)?index\.html$ https://llcarrelage.fr/$1 [R=301,L]

# Imposer HTTPS et le domaine sans www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.llcarrelage\.fr$ [NC]
RewriteRule ^ https://llcarrelage.fr%{REQUEST_URI} [R=301,L]